# Settings for the Smart Library face-recognition station on the Raspberry Pi.
# setup_pi.sh writes the real file to /etc/smart-library-station.env (readable by root only).

# Your deployed Smart Library address (no trailing slash, must be https).
SMART_LIBRARY_API_URL=https://library.example.com

# The same key as SMART_LIBRARY_IOT_KEY on the server.
SMART_LIBRARY_IOT_KEY=paste-the-key-here

# 0 = a person is recognized, you choose Time-in/Time-out on screen and confirm (original behaviour).
# 1 = attendance is saved automatically: first recognition = Time-in, next visit = Time-out.
SMART_LIBRARY_AUTO_ATTENDANCE=0

# Auto mode only: minimum seconds before the same person can be recorded again.
SMART_LIBRARY_AUTO_COOLDOWN=60

# Camera number (0 = the first camera). Leave as is for a single Camera Module.
SMART_LIBRARY_CAMERA=0

# Keep the station reachable only from this Pi. It has no login of its own, so do NOT set this to 0.0.0.0.
SMART_LIBRARY_STATION_HOST=127.0.0.1
SMART_LIBRARY_STATION_PORT=5001
