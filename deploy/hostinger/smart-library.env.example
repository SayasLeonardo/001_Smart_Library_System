# Settings for the Smart Library System on a Hostinger VPS.
# setup_vps.sh copies this to /etc/smart-library/smart-library.env and fills in the two secrets.
# Never commit the real file and never share its contents.

SMART_LIBRARY_PRODUCTION=1
SMART_LIBRARY_BEHIND_PROXY=1
SMART_LIBRARY_HTTPS=1

# Signs login sessions. Generated for you by setup_vps.sh.
SMART_LIBRARY_SECRET=__SECRET__

# Shared key the Raspberry Pi sends as X-IOT-API-Key. Generated for you by setup_vps.sh.
SMART_LIBRARY_IOT_KEY=__IOT__

# Database file, uploaded images and face models live here (SQLite mode).
SMART_LIBRARY_DATA_DIR=/var/lib/smart-library
SMART_LIBRARY_MODEL_DIR=/var/lib/smart-library/models

# Only if you keep your data in PostgreSQL instead of SQLite (see DEPLOY_HOSTINGER.md, Option B):
# DATABASE_URL=postgresql://smartlib:PASSWORD@127.0.0.1:5432/smartlib
